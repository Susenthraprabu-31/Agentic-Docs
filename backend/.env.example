SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BROWSER_MODEL=gpt-4o-mini
GROQ_API_KEY=gsk-your-groq-key
GROQ_MODEL=llama-3.3-70b-versatile
MISTRAL_API_KEY=your-mistral-key
MISTRAL_OCR_MODEL=mistral-ocr-4-1
PORT=8000
ENVIRONMENT=development
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_CHANNEL=chrome
PLAYWRIGHT_USER_DATA_DIR=.playwright-profile
PLAYWRIGHT_CLOUDFLARE_WAIT_SECONDS=300
# Optional: attach to your own Chrome (run scripts/launch_chrome_cdp.ps1 first)
PLAYWRIGHT_CDP_URL=http://127.0.0.1:9222
PLAYWRIGHT_CDP_REQUIRED=true
PLAYWRIGHT_IMPORT_SYSTEM_CHROME_COOKIES=true

# Cloudflare bypass toggles (browser_factory.py)
USE_STEALTH=true
USE_CHROME_PROFILE=false
USE_PROXY=false
USE_REAL_COOKIES=true
USE_HUMAN_DELAYS=true
# Real Chrome profile path (only when USE_CHROME_PROFILE=true)
CHROME_USER_DATA_DIR=
# Residential proxy (only when USE_PROXY=true)
PROXY_URL=http://user:pass@host:port
SUPABASE_STORAGE_BUCKET=dono-mvp
CORS_ORIGINS=http://localhost:5173
