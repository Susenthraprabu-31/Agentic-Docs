      //Format Currency
      var formatMoney = function (n) {
          if (n == undefined || n == 0) {
              return "$0";
          }
          return "$" + n.toLocaleString().split(".")[0];
      };


      //Add Property Search result to map for all searches
      var addPropertyGeometrytoMap = function ($scope, saleInfo, saleNumber, geometry, highlightColor, symbolType) {
          try {
              var fontSize = saleNumber > 99 ? 10 : 12;
              var font = new esri.symbol.Font(fontSize + "pt", esri.symbol.Font.STYLE_NORMAL, esri.symbol.Font.VARIANT_NORMAL, esri.symbol.Font.WEIGHT_BOLD, "Arial");
              var textSymbol = new esri.symbol.TextSymbol(saleNumber, font, new dojo.Color("#FFFFFF"));
              textSymbol.setAlign(esri.symbol.TextSymbol.ALIGN_MIDDLE);
              textSymbol.setOffset(0, -6);
              //Added to show boundary
              var fontBlk = new esri.symbol.Font(fontSize + "pt", esri.symbol.Font.STYLE_NORMAL, esri.symbol.Font.VARIANT_NORMAL, esri.symbol.Font.WEIGHT_BOLDER, "Arial");
              var textSymbolBlk = new esri.symbol.TextSymbol(saleNumber, font, new dojo.Color("#000"));
              textSymbolBlk.setAlign(esri.symbol.TextSymbol.ALIGN_MIDDLE);
              textSymbolBlk.setOffset(-1, -5);
              if (geometry != null && geometry.x != 0 && geometry.y != 0 && geometry.x != NaN && geometry.y != NaN) {
                  var circleSymbol;
                  if (symbolType == "CIRCLE") {
                       circleSymbol = new esri.symbol.SimpleMarkerSymbol(
                              esri.symbol.SimpleMarkerSymbol.STYLE_CIRCLE,
                              24,
                              new esri.symbol.SimpleLineSymbol(
                                esri.symbol.SimpleLineSymbol.STYLE_SOLID,
                                new dojo.Color([255, 255, 255, 1.0]), 1.5
                              ),
                              new dojo.Color(highlightColor)
                              );
                  }
                  if (symbolType == "SQUARE") {
                      circleSymbol = new esri.symbol.SimpleMarkerSymbol(
                             esri.symbol.SimpleMarkerSymbol.STYLE_SQUARE,
                             24,
                             new esri.symbol.SimpleLineSymbol(
                               esri.symbol.SimpleLineSymbol.STYLE_SOLID,
                               new dojo.Color([255, 255, 255, 1.0]), 1.5
                             ),
                             new dojo.Color(highlightColor)
                             );
                  }
                  var circleRenderer = new esri.renderer.SimpleRenderer(circleSymbol);
                  var newCircle = new esri.Graphic(geometry, circleSymbol);
                  newCircle.attributes = saleInfo;
                  if ($scope.map.getLayer("circleResultLayer")) {
                      $scope.map.getLayer("circleResultLayer").add(newCircle);
                      var newCircleText = new esri.Graphic(geometry, textSymbolBlk);
                      newCircleText.attributes = saleInfo;
                      $scope.map.getLayer("circleResultLayer").add(newCircleText);
                      var newCircleText = new esri.Graphic(geometry, textSymbol);
                      newCircleText.attributes = saleInfo;
                      $scope.map.getLayer("circleResultLayer").add(newCircleText);
                  }
              }
          }
          catch (error) {
              $scope.showErrorDialog("An error has occurred while adding the geometry. ");
          }
      };


      //function added to caluculate intersection of buffer and zipcode geometry
      var bufferZipCodeIntersection = function ($scope, propertyGeom, bufferGeometry) {
          var getZipCode = propertyZipCode($scope, propertyGeom, bufferGeometry);
          return getZipCode.then(function (featureSet) {
              var intersectGeom = esriGisGeometryService.getIntersectGeometries(bufferGeometry, featureSet.features[0].geometry);
              return intersectGeom.then(function (intersectGeometries) {
                  return intersectGeometries;
              });
          },
            function (error) {
                $('#load-modal').modal('hide');
                var message = "error when trying to get zipcode. ";
                return $q.reject({ "error": error, "message": message });
            }
          );
      };


      //function added to get Zipcode geometry for property based on the point geometry
      var propertyZipCode = function ($scope, propertyGeom, bufferGeometry) {
          var url = paConfig.urlZipCodeLayer;
          var whereClause = "1=1"; 
          return queryLayer($scope, url, whereClause, propertyGeom, true).then(
            function (featureSet) {
                if (featureSet.features != undefined && featureSet.features.length > 0) {
                    return featureSet;                    
                } else {
                    var message = "No ZipCode found for this geometry";
                    return $q.reject({ error: featureSet, message: message });
                }
            },
            function (error) {
                $('#load-modal').modal('hide');
                var message = "error when trying to get zipcode. ";
                return $q.reject({ "error": error, "message": message });
            }
          );
      };


      var assignColortoPropertySales = function ($scope, salesInformationArr, subjectPropertyInformation, propertyFeatureset) {
          var index = 1;
          var initRange;
          var endRange;
          var uniqueSalesArr = [];         
          var salesInformation = [];
          var saleIndex = 0;
          _.each(salesInformationArr, function (saleProp) {
              salesInformation.push({ sale: saleProp, index: saleIndex, type: 'sale' });
              saleIndex++;
          });
          var subjectIndex = 0;
          _.each(subjectPropertyInformation, function (subjectProp) {
              if (subjectProp.salePrice) {
                  salesInformation.push({ sale: subjectProp, index: subjectIndex, type: 'subject' });
                  subjectIndex++;
              }
          });
          var salesArray = uniqueSalesValues(salesInformation);
          uniqueSalesArr = salesArray.filter(function (itm, i, a) {
              return i == a.indexOf(itm);
          });
          uniqueSalesArr.sort(function (a, b) {
              if (a < b)
                  return -1;
              if (a >= b)
                  return 1;
          });
          var saleRange;
          $scope.uniqueSalesValues = uniqueSalesArr;
          if (uniqueSalesArr.length > 6) {
              saleRange = Math.floor(uniqueSalesArr.length / 6);
          }
          else {
              saleRange = 1;
          }
          _.each(salesInformation, function (sale) {
              //console.log("sale", sale);
              var highlightColor;
              var highlightColorSale;
              var propertyPrice = sale.sale.salePrice;
              switch (propertyPrice >= 0) {
                  case (propertyPrice <= (uniqueSalesArr[(saleRange * 1) - 1])):
                      highlightColor = paConfig.salesPropertyColors.color1;
                      highlightColorSale = paConfig.salesPropertyColors.color1Code;
                      break;
                  case (propertyPrice > (uniqueSalesArr[(saleRange * 1) - 1]) && propertyPrice <= (uniqueSalesArr[(saleRange * 2) - 1])):
                      highlightColor = paConfig.salesPropertyColors.color2;
                      highlightColorSale = paConfig.salesPropertyColors.color2Code;
                      break;
                  case (propertyPrice > (uniqueSalesArr[(saleRange * 2) - 1]) && propertyPrice <= (uniqueSalesArr[(saleRange * 3) - 1])):
                      highlightColor = paConfig.salesPropertyColors.color3;
                      highlightColorSale = paConfig.salesPropertyColors.color3Code;
                      break;
                  case (propertyPrice > (uniqueSalesArr[(saleRange * 3) - 1]) && propertyPrice <= (uniqueSalesArr[(saleRange * 4) - 1])):
                      highlightColor = paConfig.salesPropertyColors.color4;
                      highlightColorSale = paConfig.salesPropertyColors.color4Code;
                      break;
                  case (propertyPrice > (uniqueSalesArr[(saleRange * 4) - 1]) && propertyPrice <= (uniqueSalesArr[(saleRange * 5) - 1])):
                      highlightColor = paConfig.salesPropertyColors.color5;
                      highlightColorSale = paConfig.salesPropertyColors.color5Code;
                      break;
                  case (propertyPrice > (salesArray[(saleRange * 5) - 1])):
                      highlightColor = paConfig.salesPropertyColors.color6;
                      highlightColorSale = paConfig.salesPropertyColors.color6Code;
                      break;
                  default:
                      highlightColor = paConfig.salesPropertyColors.color6;
                      highlightColorSale = paConfig.salesPropertyColors.color6Code;
                      break;
              }
              sale.sale.highlightColor = highlightColor;
              var getSalesCount = addSalesCountParentFolio(salesInformation, sale.sale.parentFolio);
              var saleGeometry =  getSalePropertyGeometry(propertyFeatureset,sale.sale.parentFolio);
              if (sale.type === "sale") {
                  salesInformationArr[sale.index].highlightColor = highlightColor;
                  salesInformationArr[sale.index].highlightColorCode = highlightColorSale;
                  salesInformationArr[sale.index].totalSalesCount = getSalesCount;
                  salesInformationArr[sale.index].geometry = saleGeometry;
              }
              if (sale.type === "subject") {
                  subjectPropertyInformation[sale.index].highlightColor = highlightColor;
                  subjectPropertyInformation[sale.index].highlightColorCode = highlightColorSale;
                  subjectPropertyInformation[sale.index].totalSalesCount = getSalesCount;
                  subjectPropertyInformation[sale.index].geometry = saleGeometry;
              }              
          });
      };


      //returns unique sales price value
      var uniqueSalesValues = function (salesInformation) {
          var salesArray = [];
          _.each(salesInformation, function (sale) {
              salesArray.push(sale.sale.salePrice);             
          });
          //console.log("salesArray", salesArray);
          return salesArray;
      };      
      

      //function added to add count for all sales based on the PARENT folio
      var addSalesCountParentFolio = function (salesInformationArr, parentFolio) {
          var count = 0;
          _.each(salesInformationArr, function (sale) {
              if (sale.sale.parentFolio === parentFolio) {
                  count++;
              }
          });
          return count;
      };



      var getSalePropertyGeometry = function (propertyFeatureSet, parentFolio) {
          var returnGeometry;
          _.each(propertyFeatureSet.featureSet, function (property) {
              if (property.attributes.FOLIO === parentFolio) {
                  returnGeometry = property.geometry;                  
              }
          });
          return returnGeometry;
      };

      // public API
      return {
          getXYFromFolio: xyFromFolio,
          getGraphicMarkerFromXY: graphicMarkerFromXY,
          getPolygonFromFolio: polygonFromFolio,
          getGraphicMarkerFromPolygon: graphicMarkerFromPolygon,
          getFolioFromPoint: folioFromPoint,
          getGeometryFromPointLayerIntersection: geometryFromPointLayerIntersection,
          getFeatureFromPointLayerIntersection: featureFromPointLayerIntersection,
          getFeaturesInCircle: featuresInCircle,
          getGeometryAndFolioFromXY: geometryAndFolioFromXY,
          getSalesInformation: PAPropertySalesInformation,
          getGraphicMarkerFromBufferPolygon: graphicMarkerFromBufferPolygon,
          getAddPropertyGeometrytoMap: addPropertyGeometrytoMap,
          getAddSalesPropertytoMap: addSalesPropertytoMap,
          getPropertyZipCode: propertyZipCode,
          getAssignColortoPropertySales: assignColortoPropertySales
      };
  }]);
