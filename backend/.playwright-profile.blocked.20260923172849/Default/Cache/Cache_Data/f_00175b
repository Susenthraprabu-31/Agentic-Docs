      var getPropertiesFromBuffer = function ($scope, geometryBuffer, polygonProperty) {
          var url = paConfig.urlParcelBoundariesLayer;
          var whereClause;
          if ($scope.searchParam.ZipCodeFlag) {
              var propZipCode = bufferZipCodeIntersection($scope, polygonProperty, geometryBuffer);
              return propZipCode.then(function (intersectionPoly) {
                  if (intersectionPoly.length == 0) {
                      whereClause = "1=1";
                      var message = "There is no zip code associated with this property. The report will be created without any zip code.";
                      $scope.showErrorDialog(message);

                  } else {
                      whereClause = "1=1";
                      geometryBuffer = intersectionPoly[0];
                  }
                  if ($scope.searchParam.SubDivFlag) {
                      whereClause = whereClause + " AND FOLIO LIKE '" + $scope.folio.substr(0, 9) + "%'";
                  } else if ($scope.searchParam.MunicipalityFlag) {
                      whereClause = whereClause + " AND FOLIO LIKE '" + $scope.folio.substr(0, 2) + "%'";
                  }
                  return queryLayer($scope, url, whereClause, geometryBuffer, true).then(
                function (featureSet) {
                    if (featureSet.features != undefined && featureSet.features.length > 0) {
                        return {
                            featureSet: featureSet.features
                        };
                    } else {
                        var message = "No properties found in the selected buffer ";
                        return $q.reject({ error: featureSet, message: message });
                    }
                },
                function (error) {
                    $('#load-modal').modal('hide');
                    var message = "error when trying to get properties in the selected buffer. "
                    return $q.reject({ "error": error, "message": message });
                }
              );
              });
          }
          else {
              if ($scope.searchParam.SubDivFlag) {
                  whereClause = "FOLIO LIKE '" + $scope.folio.substr(0, 9) + "%'";
              }
              else if ($scope.searchParam.MunicipalityFlag) {
                  whereClause = "FOLIO LIKE '" + $scope.folio.substr(0, 2) + "%'";
              }
              else {
                  whereClause = "1=1";
              }
              return queryLayer($scope, url, whereClause, geometryBuffer, true).then(
                function (featureSet) {
                    if (featureSet.features != undefined && featureSet.features.length > 0) {
                        return {
                            featureSet: featureSet.features
                        };
                    } else {
                        var message = "No properties found in the selected buffer ";
                        return $q.reject({ error: featureSet, message: message });
                    }
                },
                function (error) {
                    $('#load-modal').modal('hide');
                    var message = "error when trying to get properties in the selected buffer. "
                    return $q.reject({ "error": error, "message": message });
                }
              );
          }
      };


