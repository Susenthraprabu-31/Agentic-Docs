    <script>
        (function () {
            'use strict';

            /* ── Sync aria-expanded when Bootstrap opens/closes a dropdown ── */
            $(document).on('show.bs.dropdown', function (e) {
                $(e.target).find('[aria-haspopup="true"]').attr('aria-expanded', 'true');
            });
            $(document).on('hide.bs.dropdown', function (e) {
                $(e.target).find('[aria-haspopup="true"]').attr('aria-expanded', 'false');
            });

            /* ── Full keyboard navigation for dropdown menus ────────────── */
            $(document).on('keydown', '.dropdown-toggle', function (e) {
                var $toggle = $(this);
                var $parent = $toggle.closest('.dropdown');
                var isOpen = $parent.hasClass('open');

                /* Enter or Space: toggle the dropdown */
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    $toggle.trigger('click');
                    if (!isOpen) {
                        /* Move focus to first menu item after opening */
                        setTimeout(function () {
                            $parent.find('.dropdown-menu [role="menuitem"]:visible:first').focus();
                        }, 50);
                    }
                    return;
                }

                /* Arrow Down: open menu and focus first item */
                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    if (!isOpen) { $toggle.trigger('click'); }
                    setTimeout(function () {
                        $parent.find('.dropdown-menu [role="menuitem"]:visible:first').focus();
                    }, 50);
                    return;
                }

                /* Arrow Up: open menu and focus last item */
                if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    if (!isOpen) { $toggle.trigger('click'); }
                    setTimeout(function () {
                        $parent.find('.dropdown-menu [role="menuitem"]:visible:last').focus();
                    }, 50);
                    return;
                }
            });

            $(document).on('keydown', '.dropdown-menu [role="menuitem"]', function (e) {
                var $item = $(this);
                var $menu = $item.closest('.dropdown-menu');
                var $parent = $item.closest('.dropdown');
                var $items = $menu.find('[role="menuitem"]:visible');
                var index = $items.index($item);

                /* Arrow Down: next item (wraps to first) */
                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    $items.eq(index < $items.length - 1 ? index + 1 : 0).focus();
                    return;
                }

                /* Arrow Up: previous item (wraps to last) */
                if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    $items.eq(index > 0 ? index - 1 : $items.length - 1).focus();
                    return;
                }

                /* Escape: close menu, return focus to toggle */
                if (e.key === 'Escape') {
                    e.preventDefault();
                    $parent.removeClass('open');
                    $parent.find('.dropdown-toggle')
                        .attr('aria-expanded', 'false')
                        .focus();
                    return;
                }

                /* Tab: close menu (focus moves naturally) */
                if (e.key === 'Tab') {
                    $parent.removeClass('open');
                    $parent.find('.dropdown-toggle').attr('aria-expanded', 'false');
                }
            });

            /* ── Close dropdown when focus leaves the whole dropdown ────── */
            $(document).on('focusout', '.dropdown', function (e) {
                var $parent = $(this);
                /* Short timeout allows the new focused element to be set */
                setTimeout(function () {
                    if (!$.contains($parent[0], document.activeElement)) {
                        $parent.removeClass('open');
                        $parent.find('.dropdown-toggle').attr('aria-expanded', 'false');
                    }
                }, 100);
            });

        }());
    </script>
