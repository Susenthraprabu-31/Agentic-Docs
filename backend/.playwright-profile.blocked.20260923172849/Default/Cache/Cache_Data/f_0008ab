                    color: var(--navbar-highlight-color) !important; /* Dynamic highlight color */
                    background-color: transparent;
                    text-decoration: underline;
                }

            /* Dropdown toggle */
            .navbar-inverse .navbar-nav .dropdown-toggle {
                color: #ffffff;
            }

                .navbar-inverse .navbar-nav .dropdown-toggle:hover,
                .navbar-inverse .navbar-nav .dropdown-toggle:focus {
                    color: var(--navbar-highlight-color) !important; /* Dynamic highlight color */
                    text-decoration: underline;
                }

            /* Dropdown menu – meet 4.5:1 contrast on white background */
            .navbar-inverse .dropdown-menu > li > a {
                color: #1a1a1a;
            }

                .navbar-inverse .dropdown-menu > li > a:hover,
                .navbar-inverse .dropdown-menu > li > a:focus {
                    background-color: var(--dropdown-menu-highlight-color) !important;
                    color: #ffffff !important;
                    text-decoration: underline;
                }

            /* Right-side auth links */
            .navbar-inverse .navbar-nav.navbar-right > li > a,
            .navbar-inverse .navbar-nav.navbar-right > li > a:visited {
                color: #ffffff;
            }

                .navbar-inverse .navbar-nav.navbar-right > li > a:hover,
                .navbar-inverse .navbar-nav.navbar-right > li > a:focus {
                    color: var(--navbar-highlight-color) !important; /* Dynamic highlight color */
                    text-decoration: underline;
                }

            /* When dropdown is open (active state) */
            .navbar-inverse .navbar-nav .dropdown.open > a,
            .navbar-inverse .navbar-nav .dropdown.open > a:hover,
            .navbar-inverse .navbar-nav .dropdown.open > a:focus {
                background-color: rgba(255, 191, 71, 0.15) !important; /* Will be overridden dynamically */
                color: var(--navbar-highlight-color) !important;
            }

            /* LoginStatus logout link */
            .navbar-inverse .navbar-nav .navbar-right .aspNetLink,
            .navbar-inverse .navbar-nav .navbar-right a {
                color: #ffffff;
            }

        /* ── Logo ─────────────────────────────────────────────────── */
        .logo {
            height: 70px;       /* explicit logo height */
            width: auto;
        }

        .navbar-brand {
            padding: 0 15px;            /* remove top/bottom padding */
            display: flex;
            align-items: center;        /* vertically centre the logo */
            height: 70px;               /* match the logo height exactly */
