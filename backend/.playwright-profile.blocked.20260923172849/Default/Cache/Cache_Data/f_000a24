    <style>
        /* ── CSS Variables for Dynamic Theming ────────────────────── */
        :root {
            --navbar-bg-color: #222222;
            --navbar-highlight-color: #ffbf47;
            --dropdown-menu-highlight-color: #005fa3;
        }
        /* ── Skip Navigation ──────────────────────────────────────── */
        .skip-nav {
            position: absolute;
            top: -100%;
            left: 0;
            background: #005fa3;
            color: #ffffff;
            padding: 10px 20px;
            z-index: 10000;
            font-size: 1rem;
            font-weight: 600;
            border-radius: 0 0 4px 0;
            text-decoration: none;
            transition: top 0.15s ease;
        }

            .skip-nav:focus {
                top: 0;
                outline: 3px solid var(--navbar-highlight-color);
                outline-offset: 2px;
            }

        /* ── Focus Visible (global) ───────────────────────────────── */
        /* Ensure every focusable element has a visible focus ring     */
        :focus-visible {
            outline: 3px solid var(--navbar-highlight-color);
            outline-offset: 2px;
        }
        /* Remove outline for mouse users while keeping it for keyboard */
        :focus:not(:focus-visible) {
            outline: none;
        }

        /* ── Navbar ───────────────────────────────────────────────── */
        .navbar-inverse {
            background-color: var(--navbar-bg-color) !important; /* Dynamic via CSS variable */
            border-color: #080808;
        }

            /* Nav links – white on #222 = 14.75:1 (AAA) */
            .navbar-inverse .navbar-nav > li > a,
            .navbar-inverse .navbar-nav > li > a:visited {
                color: #ffffff;
            }

                .navbar-inverse .navbar-nav > li > a:hover,
                .navbar-inverse .navbar-nav > li > a:focus {
                    color: var(--navbar-highlight-color) !important; /* Dynamic highlight color */
                    background-color: transparent;
                    text-decoration: underline;
                }

            /* Dropdown toggle */
            .navbar-inverse .navbar-nav .dropdown-toggle {
                color: #ffffff;
            }

                .navbar-inverse .navbar-nav .dropdown-toggle:hover,
                .navbar-inverse .navbar-nav .dropdown-toggle:focus {
                    color: var(--navbar-highlight-color) !important; /* Dynamic highlight color */
                    text-decoration: underline;
                }

            /* Dropdown menu – meet 4.5:1 contrast on white background */
            .navbar-inverse .dropdown-menu > li > a {
                color: #1a1a1a;
            }

                .navbar-inverse .dropdown-menu > li > a:hover,
                .navbar-inverse .dropdown-menu > li > a:focus {
                    background-color: var(--dropdown-menu-highlight-color) !important;
                    color: #ffffff !important;
                    text-decoration: underline;
                }

            /* Right-side auth links */
            .navbar-inverse .navbar-nav.navbar-right > li > a,
            .navbar-inverse .navbar-nav.navbar-right > li > a:visited {
                color: #ffffff;
            }

                .navbar-inverse .navbar-nav.navbar-right > li > a:hover,
                .navbar-inverse .navbar-nav.navbar-right > li > a:focus {
                    color: var(--navbar-highlight-color) !important; /* Dynamic highlight color */
                    text-decoration: underline;
                }

            /* When dropdown is open (active state) */
            .navbar-inverse .navbar-nav .dropdown.open > a,
            .navbar-inverse .navbar-nav .dropdown.open > a:hover,
            .navbar-inverse .navbar-nav .dropdown.open > a:focus {
                background-color: rgba(255, 191, 71, 0.15) !important; /* Will be overridden dynamically */
                color: var(--navbar-highlight-color) !important;
            }

            /* LoginStatus logout link */
            .navbar-inverse .navbar-nav .navbar-right .aspNetLink,
            .navbar-inverse .navbar-nav .navbar-right a {
                color: #ffffff;
            }

        /* ── Logo ─────────────────────────────────────────────────── */
        .logo {
            height: 70px;       /* explicit logo height */
            width: auto;
        }

        .navbar-brand {
            padding: 0 15px;            /* remove top/bottom padding */
            display: flex;
            align-items: center;        /* vertically centre the logo */
            height: 70px;               /* match the logo height exactly */
        }

        /* Force the navbar itself to be at least as tall as the logo */
        .navbar {
            min-height: 70px;
        }

        .navbar .container {
            min-height: 70px;
        }

        /* ── Body padding for fixed navbar ───────────────────────── */
        body {
            padding-top: 70px; /* matches navbar min-height */
        }

        @media (max-width: 767px) {
            body {
                padding-top: 60px;
            }
        }

        /* ── Mobile dropdown adjustments ─────────────────────────── */
        @media (max-width: 767px) {
            .navbar-nav .dropdown-menu {
                position: static;
                float: none;
                width: auto;
                margin-top: 0;
                background-color: transparent;
                border: 0;
                box-shadow: none;
