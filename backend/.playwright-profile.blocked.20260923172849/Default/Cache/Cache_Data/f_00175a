'use strict';

angular.module('propertySalesApp')
   .service('propertySearchService', ['$resource', '$q', '$log', 'candidate', 'esriGisLocatorService', 'esriGisService', 'propertyService', 'comparableSalesService', 'paConfiguration', 'paComparableSalesService', function ($resource, $q, $log, candidate, esriGisLocatorService, esriGisService, propertyService, comparableSalesService, paConfig, paComparableSalesService) {

    var urlBase = paConfig.urlPropertyAppraiser;

    var PropertyResource = $resource(urlBase + ":endPoint",
                                     {endPoint:""},
                                     {propertyByFolio:{method:'GET'},
				                      candidatesByAddress:{method:'GET'},
				                      candidatesByPartialFolio:{method:'GET'},
				                      hasValidStreetName:{method:'GET'}
				     }
                                    );

    var partialPropertyInfoByFolio = function (folio, clientAppName) {
        var endPoint = "";
        var params = {
            "partialFolioNumber": folio,
            "clientAppName": paConfig.clientAppName,
            "from": 1,
            "to": 200,
            "Operation": "GetPropertySearchByPartialFolio",
            "endPoint": endPoint
        };
        var deferred = $q.defer();
        var rawProperty = PropertyResource.propertyByFolio(params, function () {
            deferred.resolve(new candidate.getCandidatesFromPaData(rawProperty));
         
        }, function (response) {
            $log.error("propertySearchService:propertyByFolio:", urlBase, folio, response);
            deferred.reject("The request failed. Try again later.")
        });

        return deferred.promise.then(function (property) {
            return property;
        }, function (response) {
            $log.error("propertySearchService:propertyByFolio:", urlBase, folio, response);
            return $q.reject({ message: response });
        });
    };


      /**
     * Requests property information by folio. s
     * When Folio is found return the property. 
     * When the Folio does not exist, or the request
     * failed an object of the form {message:"some message"}
     * is returned.
     **/
    var propertyByFolio = function(folio, clientAppName){
      var endPoint = "";
      var params = {"folioNumber":folio, 
                    "clientAppName":clientAppName || paConfig.clientAppName, 
                    "Operation":'GetPropertySearchByFolio',
                    "endPoint":endPoint};         

      var deferred = $q.defer();
      var rawProperty = PropertyResource.propertyByFolio(params, function (){
        if(propertyService.isPropertyValid(rawProperty))
          deferred.resolve(new propertyService.Property(rawProperty));
        else
          deferred.reject(rawProperty.Message)
      }, function(response){
        $log.error("propertySearchService:propertyByFolio:", urlBase, folio, response);
        deferred.reject("The request failed. Try again later.")});
      
      return deferred.promise.then(function(property){
	return property;
      }, function(response){
        $log.error("propertySearchService:propertyByFolio:", urlBase, folio, response);
        return $q.reject({message:response});
      });
    };

	var candidatesByPartialFolios = function(folios, clientAppName){
	  var partialFolioPromises = [];
      // Get a promise for each partial folio.
      _.each(folios, function(folio){
        partialFolioPromises.push(candidatesByPartialFolio(folio, 1, 200, clientAppName).then(
          function(data){return data},
          function(response){return null }
        ));
      });

      var all = $q.all(partialFolioPromises);
      return all.then(function(data){
        var filteredData =  _.filter(data, function(candidate){
			return candidate.completed == true;
		});
		return filteredData;
     });
	};
    
	/**
     * return a promise where the data returned by that promise is an array of
     * propertyService.Property objects for each one of
     * the folios. It discard folios that are not found.
     * When passing an empty array of folios or null the promise
     * returns an ampty array as data.
     **/
    var propertiesByFolios = function(folios, clientAppName){
      //self = this;
      var propertyPromises = [];
      
      // Get a promise for each folio.
      _.each(folios, function(folio){
        propertyPromises.push(propertyByFolio(folio, clientAppName).then(
          function(data){return data},
          function(response){return null }
        ));
      });

      // Discard not existing properties.
      var all = $q.all(propertyPromises);
      return all.then(function(data){
        $log.debug("propertySearchService:propertiesByFolios: ", data);
        return _.filter(data, function(property){return property != null});
      });
    };
    
   
   
    var candidatesByAddressFromPA = function(address, unit, from, to, clientAppName){
      var endPoint = "";
	  var appName = _.isUndefined(clientAppName) ? paConfig.clientAppName : clientAppName;
      var params = {"myAddress":address, "myUnit":unit, 
                    "clientAppName": appName, 
                    "from":from, 
                    "to":to, 
                    "Operation":'GetAddress',
                    "endPoint": endPoint
                   };

      
      var deferred = $q.defer();
      var candidatesList = PropertyResource.candidatesByAddress(params, 
        function(){
          deferred.resolve(candidate.getCandidatesFromPaData(candidatesList));
        },
        function(response){
          deferred.reject(response);
        });

      return deferred.promise.then(function(candidatesList){
	return candidatesList;
      }, function(response){
        $log.error("propertySearchService:candidatesByAddress:", urlBase, address, unit, response);
        return $q.reject(response);
      });

    };
    
    var candidatesByPartialFolio = function(partialFolio, from, to, clientAppName){
      var endPoint = "";
	  var appName = _.isUndefined(clientAppName) ? paConfig.clientAppName : clientAppName;
      var params = {"partialFolioNumber":partialFolio, 
                    "clientAppName": appName, 
                    "from":from, 
                    "to":to, 
                    "Operation":"GetPropertySearchByPartialFolio",
                    "endPoint":endPoint};
      
      var deferred = $q.defer();
      var candidatesList = PropertyResource.candidatesByPartialFolio(params, 
	                                                             function(){
		                                                       deferred.resolve(candidate.getCandidatesFromPaData(candidatesList));
		                                                     },
		                                                     function(response){
		                                                       deferred.reject(response);
	                                                             });


      return deferred.promise.then(function(candidatesList){
	return candidatesList;
      }, function(response){
        $log.error("propertySearchService:candidatesByPartialFolio:", urlBase, partialFolio, response);
        return $q.reject(response);
      });

    };
    

    var hasValidStreetName = function(address, callback){
      var endPoint = "";
      var params = {"myAddress":address, 
                    "clientAppName":paConfig.clientAppName, 
                    "Operation":"ContainsValidStreetName",
                    "endPoint":endPoint};
      
      var deferred = $q.defer();
      
      var isValidStreet = PropertyResource.hasValidStreetName(params, 
	                                                      function(){
		                                                deferred.resolve({
	                                                          completed:isValidStreet.Completed,
	                                                          message:isValidStreet.Message,
	                                                          valid:isValidStreet.Valid
	                                                        });
		                                              },
		                                              function(response){
		                                                deferred.reject(response);
	                                                      });

      return deferred.promise.then(function(isValidStreet){
	return isValidStreet;
      }, function(response){
        $log.error("propertySearchService:hasValidStreetName:", response);
        return $q.reject(response);
      });

    };


  var candidatesByAddress = function(address, unit, from, to, clientAppName){
    var promise = candidatesByAddressFromPA(address, unit, from, to, clientAppName);
      return promise.then(
        function(result){
          if(result.completed == true) 
            return result;
          else
            var message = result.message;
          return candidatesByAddressFromEsri(address).then(function(result){
            if(result.candidates.length == 0)
              result.message = message;
            return result;
          });
        }, function(error){
          return $q.reject({error:error, message:"The request failed. Please try again later"});
        });
   };

   var candidatesByAddressFromEsri = function(address){
      var promise = esriGisLocatorService.locator20(address);
      return promise.then(
        function(data){
          $log.debug("getCandidatesByAddressFromEsri: data from locator", data);
          if(data.found){
            return esriCandidateRoute(data);
          }else{
            return noEsriCandidateRoute(data.candidates);
          }
        }, function(error){
          var candidates = candidate.getCandidatesFromEsriData({error:true});
          $log.error("getCandidatesByAddressFromEsri. returning default candidates", error, candidates);
          return $q.reject(candidates);
        });
    }

    var esriCandidateRoute = function(data){
      var candidates = candidate.getCandidatesFromEsriData(data);
      var folios = _.pluck(candidates.candidates, 'folio');
	  return candidatesByPartialFolios(folios, paConfig.clientAppNameGeo)
	    .then(candidate.getCandidatesFromAllPartialFolios);
    }

    var noEsriCandidateRoute = function(candidates){
        //console.log("candidates", candidates);
      var x = candidates[0].location.x;
      var y = candidates[0].location.y;
      var url = paConfig.urlParcelBoundariesLayer;

      return esriGisService.getFeaturesInCircle(x, y, 100, url, false)
        .then(candidatesFromFeatures)
	.then(candidate.getCandidatesFromAllPartialFolios);
    };
    
    var candidatesFromFeatures = function(features){
      var folios = _.map(features, function(feature){return feature.attributes.FOLIO});
	  var promise = candidatesByPartialFolios(folios, paConfig.clientAppNameGeo);
      return promise.then(function(candidates){
		return candidates;
	  });
    };


    var propertySalesByFolio = function ($scope, folio, clientAppName) {        
        var deferred = $q.defer();
        var getPropertyFoliosPromise = esriGisService.getSalesInformation($scope, folio);
        return getPropertyFoliosPromise.then(function (propertyFolios) {
            if (propertyFolios === undefined) {
                $scope.showErrorDialog("A map service error has occurred  (folio array empty).  Please try again.");
                return;
            }
            if ($scope.searchParam.Folios.length == 0) {
                $scope.showErrorDialog("A map service error has occurred  (folio array empty).  Please try again.");
               // return;
            }
            if ($scope.searchParam.Folios.length >= $scope.defaultValues.queryMaxRecordLimit) {
                $scope.showErrorDialog("The number of properties within the range exceed the system limits.  Try reducing the radius to 1/8 or 100ft.");
                return;
            }
            else {
                var compSalesPromise = paComparableSalesService.getPASalesInformation($scope, $scope.searchParam);
                return compSalesPromise.then(function (defaultSalesValues) {
                    var assignColortoSalesArr = esriGisService.getAssignColortoPropertySales($scope, defaultSalesValues.salesInformationArr, defaultSalesValues.subjectPropertyArr, propertyFolios);
                    $scope.comparableSales = defaultSalesValues;
                    $scope.comparableSales.searchYear = $scope.searchParam.SalesYearMin;
                    $scope.comparableSales.searchDistance = $scope.searchParam.DistanceCode;
                    if ($scope.property) {
                        $scope.comparableSales.subjectProperty = $scope.property;
                        if ($scope.property.siteAddress) {
                            $scope.comparableSales.searchAddressFolio = $scope.property.siteAddress;
                        }
                        else {
                            $scope.comparableSales.searchAddressFolio = $scope.property.folio;
                        }
                    }
                    try{                  
                        var showSalesInfo = esriGisService.getAddSalesPropertytoMap($scope, propertyFolios, defaultSalesValues.salesInformationArr, defaultSalesValues.subjectPropertyArr);
                    }
                    catch (error){
                        alert(error.message);
                    }
                    
                    });
            }
        }, function (error) {
            $log.error("propertySalesByFolio", error, folio);
            $scope.showErrorDialog(error.message);
            return $q.reject(error);
        });
    };
   
    var propertiesFromFeatures = function (features) {
        var folios = _.map(features, function (feature) { return feature.attributes.FOLIO });
        var promise = salesPropertiesByFolios(folios, paConfig.clientAppNameGeo);
        return promise.then(function (properties) {
            return properties
        }, function (error) {
            $log.error("propertySearchService:propertiesFromFeatures", error);
            $scope.showErrorDialog(error.message);
            return $q.reject(error);
        });
    };

    var getFormatedDate = function (_date) {
        if (_date) {
            var d1 = _date.substr(0, 4);
            var d2 = _date.substr(4, 2);
            var d3 = _date.substr(6, 2);
            return d1 + '/' + d2 + '/' + d3;
        } else
            return "";
    };

    var salesPropertiesByFolios = function (folios, clientAppName) {
        //self = this;
        var propertyPromises = [];
        // Get a promise for each folio.
        _.each(folios, function (folio) {
            propertyPromises.push(partialPropertyInfoByFolio(folio, clientAppName).then(
              function (data) { return data },
              function (response) { return null }
            ));
        });
        // Discard not existing properties.
        var all = $q.all(propertyPromises);
        return all.then(function (data) {
            $log.debug("propertySearchService:propertiesByFolios: ", data)
            return _.filter(data, function (property) { return property != null });
        });
    };
    
    var validateFolio = function ($scope, folio) {
        var validateFolioInformation = partialPropertyInfoByFolio(folio, $scope.fromPage, $scope.toPage);
        return validateFolioInformation.then(function (validPropertyInfo) {
            $scope.property = validPropertyInfo.candidates[0];
            return validPropertyInfo;
        }, function (response) {
            $log.error("propertySearchService:validateFolio:", folio);
            return $q.reject(response);
        });
    }


    // public API
    return {getPropertyByFolio:propertyByFolio,
            getPropertiesByFolios:propertiesByFolios,
            getCandidatesByAddressFromEsri:candidatesByAddressFromEsri,
            getCandidatesByAddressFromPA:candidatesByAddressFromPA,
	        getCandidatesByAddress:candidatesByAddress,
	        getCandidatesByPartialFolio:candidatesByPartialFolio,
	        getHasValidStreetName: hasValidStreetName,
	        getPropertySalesByFolio: propertySalesByFolio,	        
	        getValidateFolio: validateFolio
          
           };

  }]);

