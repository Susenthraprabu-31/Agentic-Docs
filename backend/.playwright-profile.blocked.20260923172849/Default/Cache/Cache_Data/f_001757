     var keyPressProp = "";
     $scope.gotoSelectedSales = function (event) {
         var keyValue = String.fromCharCode(event.keyCode);
         var keyPress = keyValue.toLowerCase(); //event.key
         keyPressProp += keyPress;
         var foundValue = false;
         $('#ulPropertyType').find("li").each(function (idx, item) {             
             if (($(item).text().toLowerCase()).search(keyPressProp.toLowerCase()) == 0) {
                  $('#ulPropertyType').scrollTop(0);
                  var offset = $(item).position().top;
                  $('#ulPropertyType').scrollTop(offset);
                  foundValue = true;
                  return false;
              }
         });
         if (!foundValue) {
             keyPressProp = keyPress;
             $('#ulPropertyType').find("li").each(function (idx, item) {
                 if ($(item).text().charAt(0).toLowerCase() == keyPress) {
                     $('#ulPropertyType').scrollTop(0);
                     var offset = $(item).position().top;
                     $('#ulPropertyType').scrollTop(offset);
                     foundValue = true;
                     return false;
                 }
             });
         }
      };

