      $scope.graphicCircleClicked = function (event) {          
          //$scope.comparableSales.highLightSalesParentFolio("tdSales" + event.graphic.attributes.salesNumber, event.graphic.attributes.salesNumber, event.graphic.attributes.parentFolio, $scope);
          var rowIdArray = [];
          _.each($scope.comparableSales.salesInformationArr, function (sale) {
              if (sale.parentFolio === event.graphic.attributes.parentFolio) {
                  sale.highlightRow = true;
                  rowIdArray.push(sale.salesNumber);
              }
              else {
                  sale.highlightRow = false;
              }
          });
          if (rowIdArray.length > 0) {
              $scope.comparableSales.scrolltoSalesNumber("tdSales" + rowIdArray[0], rowIdArray[0], $scope);
          }
          else {
              $scope.comparableSales.scrolltoSalesNumber("tdSales" + event.graphic.attributes.salesNumber, event.graphic.attributes.salesNumber, $scope);
          }
          $scope.$apply();
      };
     
