      //Format Number
      function formatNumber(n) {
          if (n == undefined || n == 0) {
              return "0";
          }
         // return n;
          return n.toLocaleString().split(".")[0];
      }

      //Format number for Lot size
      function formatNumberLot(n) {
          if (n == undefined || n == 0) {
              return "0";
          }
          n = roundNumber(n, 2);
          if (n.toLocaleString().split(".")[1] == "00") {
              return n.toLocaleString().split(".")[0];
          }
          return n.toLocaleString();
      }

      //Round number
      function roundNumber(n, dec) {
          n = parseFloat(n);
          if (!isNaN(n)) {
              if (!dec) dec = 0;
              var factor = Math.pow(10, dec);
              return Math.floor(n * factor + ((n * factor * 10) % 10 >= 5 ? 1 : 0)) / factor;
          } else {
              return n;
          }
      }


