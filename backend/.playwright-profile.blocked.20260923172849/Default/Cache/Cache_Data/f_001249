                /* Arrow Down: next item (wraps to first) */
                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    $items.eq(index < $items.length - 1 ? index + 1 : 0).focus();
                    return;
                }

                /* Arrow Up: previous item (wraps to last) */
                if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    $items.eq(index > 0 ? index - 1 : $items.length - 1).focus();
                    return;
                }

                /* Escape: close menu, return focus to toggle */
                if (e.key === 'Escape') {
                    e.preventDefault();
                    $parent.removeClass('open');
                    $parent.find('.dropdown-toggle')
                        .attr('aria-expanded', 'false')
                        .focus();
                    return;
                }

                /* Tab: close menu (focus moves naturally) */
                if (e.key === 'Tab') {
                    $parent.removeClass('open');
                    $parent.find('.dropdown-toggle').attr('aria-expanded', 'false');
                }
            });

            /* ── Close dropdown when focus leaves the whole dropdown ────── */
            $(document).on('focusout', '.dropdown', function (e) {
                var $parent = $(this);
                /* Short timeout allows the new focused element to be set */
                setTimeout(function () {
                    if (!$.contains($parent[0], document.activeElement)) {
                        $parent.removeClass('open');
                        $parent.find('.dropdown-toggle').attr('aria-expanded', 'false');
                    }
                }, 100);
            });

        }());
    </script>
