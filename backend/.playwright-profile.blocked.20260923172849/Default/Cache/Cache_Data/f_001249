            .navbar-inverse .navbar-nav .dropdown-toggle {
                color: #ffffff;
            }

                .navbar-inverse .navbar-nav .dropdown-toggle:hover,
                .navbar-inverse .navbar-nav .dropdown-toggle:focus {
                    color: var(--navbar-highlight-color) !important; /* Dynamic highlight color */
                    text-decoration: underline;
                }

            /* Dropdown menu – meet 4.5:1 contrast on white background */
            .navbar-inverse .dropdown-menu > li > a {
                color: #1a1a1a;
